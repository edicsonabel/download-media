# Python build & install artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test / type-check / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# makepkg build artifacts (only inside legacy/ for now)
legacy/src/
legacy/pkg/
*.pkg.tar.*
*.log

# Scratch / test downloads (keep folder, ignore contents)
tmp/*
!tmp/.gitkeep

# AI tools: .ai/ is the source of truth and is versioned. These are symlinks
# into it, regenerated by scripts/ai-link.py.
.claude/
.opencode/
.ai/live.env

# One worktree per pipeline item (see .ai/orchestration/)
.worktrees/
